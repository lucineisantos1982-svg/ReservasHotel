@{
    ViewData["Title"] = "Home Page";
}

<style>
    body {
        background: linear-gradient(rgba(0, 0, 0, 0.25), rgba(0, 0, 0, 0.25)),
                    url('/paisagem.jpg') no-repeat center center fixed;
        background-size: cover;
    }

    .footer {
        background-color: rgba(255, 255, 255, 0.85);
    }
</style>

<div class="text-center text-white py-5" style="text-shadow: 1px 1px 6px rgba(0, 0, 0, 0.6);">
    <h1 class="display-4">Bem-vindo ao ReservasHotel</h1>
    <p class="lead">Gerencie hóspedes, quartos e reservas em um só lugar.</p>
    <a asp-controller="Reservas" asp-action="Create" class="btn btn-primary btn-lg">Nova reserva</a>
</div>