@model ReservasHotel.Models.Quarto
@{
    ViewData["Title"] = "Excluir quarto";
}

<h1>Excluir quarto</h1>
<h5 class="text-danger">Tem certeza que deseja excluir este quarto?</h5>

<dl class="row">
    <dt class="col-sm-2">Número</dt>
    <dd class="col-sm-10">@Model.Numero</dd>
    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.TipoQuarto?.Nome</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Excluir</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>